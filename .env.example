# Copy this file to ".env" and fill in any keys you have.
# Both are OPTIONAL -- Link Suraksha's local rule-based detector works
# fully without either of them. Leave a value blank to skip that check.

VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# Optional: override the Odia neural voice used for the voice alert.
# Default is or-IN-SubhasiniNeural (female). or-IN-SukantNeural (male)
# is also available via the same edge-tts service.
ODIA_TTS_VOICE=or-IN-SubhasiniNeural
